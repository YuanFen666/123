; ============================================================================
;  配置模板：复制成 config.ini 再填自己的值
;  【重要】config.ini 含账号密码与各种 token，已被 .gitignore 忽略，
;          千万不要提交到公开仓库（本文件是脱敏模板，可以提交）。
; ============================================================================

[common]
use_cookies=false
username = 
password = 
course_list =
speed = 1
jobs = 8
notopen_action = retry

; ---- 考试作答（整卷模式需要的一个入口参数）----
; 考试走「整卷模式」时，入口 URL 里必须带 openc。它不在开考接口的返回里，
; 但就明明白白写在浏览器的考试页地址栏里，形如：
;   https://mooc1.chaoxing.com/exam-ans/mooc2/exam/preview?...&openc=0db83d1385b675201fc5f7527b80a8c4&...
; 把 ?openc= 后面那串复制到这里即可（每次开考可能不同）：
exam_openc =

; ---- 考试作答（可选，默认关闭；开启前请看下面这段说明）----
; 【使用说明】
;   · 它会替你进考场、用题库链逐题作答：第 2 档只保存答案（你自己交卷），
;     第 3 档答完并自动交卷（覆盖率达标才交）。
;   · 前提一：先用「只体检」确认这场考试现在能考（别卡在章节任务点门槛上）。
;   · 前提二：进考场就开始计时、通常只有一次机会，所以第一次请用第 2 档，
;     由程序答题、你核对后再交卷。
;   · 已知限制：整卷模式（一页显示全部题）的考试需要 openc 才能保存，该值只在
;     浏览器考试页 URL 里（?openc=…），填到上面的 exam_openc；这类考试更推荐
;     直接用浏览器里的答题脚本。
;   · 成本：命中本地 cache.json / answer_key.json 的题目不消耗任何题库额度。
;   · 每场考试都会消耗一次机会、进考场就开始计时，所以默认**一场跑完就停**，
;     不会自动接着考下一门（要一次处理多场就把下面调大，风险自负）。
exam_take_max = 1

; ---- 考试看板 ----
; 每次运行都会列出所有课程的考试、状态和截止倒计时，并写进日志/控制台；
; 配了通知渠道（[notification] 段的 url）时还会推送到手机。
exam_watch = true
; 剩余时间不足这么多小时时，每次运行都重复提醒（并标 ⚠）
exam_warn_hours = 48

; ============================================================
;  多账号（可选）
;  一行一个账号，格式：手机号 = 密码
;    · 只写一组 → 直接用这组登录（不会问你）
;    · 写两组以上 → 启动时列出让你选
;    · 这一整段留空或删掉 → 用上面 [common] 里的 username/password
;  key 是手机号、value 是密码，所以密码里含逗号/冒号/等号都不影响。
;  密码是明文，别把这个文件发给别人（发布脚本会自动跳过这一段）。
;  ⚠ 注意：这里配了账号就会**优先于** [common] 里的 username/password。
; ============================================================
[accounts]
# 13000000000 = 你的密码    ; <- 已移除，请自己填
# 13000000000 = 你的密码    ; <- 已移除，请自己填

[tiku]
; ============================================================
;  查询顺序（2026-09-12 实测后重排）
;
;  为什么把 AI 提到第一位 —— 同一批题 A/B 实测：
;                      耗时          答出率      单价
;    ANEVOL 题库     20~42 秒/题       5/8      ¥0.0015/题
;    直连 DeepSeek   0.5~2 秒/题       8/8      ¥0.00014~0.00028/题
;    即：慢 65 倍、还答不出来、还贵 5~10 倍。考试每题多等 30 秒 = 85 题多 40 分钟。
;
;  另一条：日志统计 338 次作答里
;    ANEVOL 命中 302 次(89%)、AI 兜底 24 次(7%)、网课小工具只命中 12 次(3.5%)
;    而网课小工具留下了 473 次「未收录」——命中率极低却拖慢每题，
;    所以从链路里去掉了（想留作第三道防线可以在末尾加回 ,TikuIcodef）。
;
;  本地缓存永远最先查，命中不花任何钱、不走网络（日志里已有 36 次命中）。
; ============================================================
;
;  【关闭题库模式】provider 留空 = 不查答案、不答题，只做视频/文档任务点
; ============================================================
provider = AI,TikuAnevol

; ---------- 网课小工具题库（GO题）----------
; 接口地址，留空会自动用这个默认值
icodef_url = https://cx.icodef.com/wyn-nb?v=4
; 官方限制「1 并发」，程序内部已强制串行；这里是两次请求之间的最小间隔（秒）。
; 实测 0.3 秒太激进：8 个 worker 同时开章节时会打出突发请求，
; 服务端仍会返回 code=-2「触发流控限制: 1并发限制」（实测 20 次请求里 5 次中招，每次白等 2 秒）。
; 调到 1.5 秒后突发被摊平，基本不再触发。若还偶发，可继续往上调（2、3），无需重新打包。
icodef_min_interval = 1.5
; 读超时（秒）
icodef_timeout = 15
; 可选：填了会带上 Authorization 请求头（不填=不带，公开接口够用）
icodef_authorization = 

; ---------- ANEVOL 题库 ----------
; ANEVOL 接口地址（留空也会自动用这个默认值）
url = https://tiku.anevol.cn/api/search
; ANEVOL token，多个用英文逗号分隔（只用第一个）
tokens = 
; ANEVOL 请求最小间隔（秒），别调太小，容易被限流
anevol_min_interval = 0.3

; 达到覆盖率后自动提交（true=答完就交；false=只保存不提交）
submit = true

; 最低题库覆盖率（搜到的题占总题数的比例）
cover_rate = 0.8

; 每道题之间的间隔（秒）
delay = 1.5

; 判断题匹配规则（内置实现会把题库的判断题答案归一化成“正确/错误”）
true_list = 正确,对,√,是
false_list = 错误,错,×,否,不对,不正确

; ---- AI 兜底（第三道防线，DeepSeek）----
; 【必须填 key，留空的话 AI 会被自动跳过，并在日志里明确提示“AI 兜底未配置完整”】
; 申请地址：https://platform.deepseek.com/api_keys   （充值几块钱能用很久）
endpoint = https://api.deepseek.com/v1
key = 
model = deepseek-chat
; AI 请求最小间隔（秒），防止 8 个 worker 同时答题把接口打爆
min_interval_seconds = 3
; 可选：需要走代理时填，例如 http://127.0.0.1:7890，不需要留空
http_proxy =

; ---- 以下为其它内置题库专用，用上面这套时全部留空 ----
likeapi_search = false
likeapi_model =
siliconflow_key = 
siliconflow_model =
siliconflow_endpoint =

[notification]
provider = ServerChan
url =
tg_chat_id = XXXXXX